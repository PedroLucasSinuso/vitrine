# ──────────────────────────────────────────────
# INFRAESTRUTURA (obrigatório — manter sempre)
# ──────────────────────────────────────────────
# Banco da aplicação. Com DATABASE_URL definida, SQLITE_URL é ignorada.
# No docker compose, DATABASE_URL já aponta para o serviço "db".
DATABASE_URL=
SQLITE_URL=sqlite:///./data/price_checker.db
JWT_SECRET=sua-chave-secreta-grande-e-aleatoria

# URLs permitidas para CORS (frontend)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Chave PRIMÁRIA para criptografar senhas de configurações sensíveis no banco
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERPS_ENCRYPTION_KEY=

# Chaves ANTIGAS (opcional, separadas por vírgula) — só para poder rotacionar
# ERPS_ENCRYPTION_KEY sem perder acesso a senhas já criptografadas. Veja o
# processo completo em scripts/rotate_encryption_key.py.
ERPS_ENCRYPTION_KEY_OLD=

ALLOW_ORIGIN_REGEX=https://.*\.trycloudflare\.com

# ──────────────────────────────────────────────
# CONFIGURAÇÕES OPERACIONAIS (opcional)
# ──────────────────────────────────────────────
# Estas variáveis foram migradas para a tela de Admin > Configurações.
# Se estiverem preenchidas aqui, o sistema as copia automaticamente
# para o banco na primeira execução. Depois de configuradas pela UI,
# os valores no .env são ignorados.
#
# POSTGRES_URL=postgresql://usuario:senha@host:5432/banco
# POSTGRES_HOST=host
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=banco
# POSTGRES_USER=usuario
# POSTGRES_PASSWORD=senha
# CACHE_REFRESH_INTERVAL=3600
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=

# ── Modo demonstração (só importa se você rodou `provisionar-demo`) ────────
# O visitante da demo entra como admin e pode mexer em tudo, então o tenant
# se reseta sozinho: na entrada (respeitando o cooldown) e periodicamente.
# COOLDOWN: janela mínima entre dois resets disparados por entrada.
# INTERVAL: limpeza periódica; 0 desliga só essa camada.
# DEMO_RESET_COOLDOWN_MINUTES=10
# DEMO_RESET_INTERVAL_MINUTES=180

# Fuso do container (o docker-compose já assume America/Sao_Paulo). Todo o
# corte de data do BI usa a data local do servidor — se a loja estiver em
# outro fuso, ajuste aqui.
# TZ=America/Sao_Paulo

# ──────────────────────────────────────────────
# IMPORTAÇÃO COM IA (opcional)
# ──────────────────────────────────────────────
# Sem configuração, a importação funciona só com mapeamento manual e templates.
# IA_PROVEDOR: "anthropic" (padrão) ou "openai" (qualquer API compatível com OpenAI:
# OpenAI, Mistral, Ollama, vLLM...).
IA_IMPORTACAO_HABILITADA=true
IA_PROVEDOR=anthropic
IA_COTA_MENSAL=50

# Anthropic: basta a chave (modelo padrão claude-opus-5; troque em IA_MODELO).
ANTHROPIC_API_KEY=
# IA_MODELO=

# OpenAI-compatível (exemplo Mistral). IA_MODELO e IA_BASE_URL (ou IA_API_KEY, que
# assume a OpenAI) são obrigatórios; servidor local dispensa a chave.
# IA_PROVEDOR=openai
# IA_BASE_URL=https://api.mistral.ai/v1
# IA_MODELO=open-mistral-nemo
# IA_API_KEY=
# IA_MODO_JSON=auto        # auto | json_schema | json_object | prompt
# IA_TIMEOUT_SEGUNDOS=90
